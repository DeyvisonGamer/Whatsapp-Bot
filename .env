# Copie este arquivo pra ".env" (sem o ".example" no final) e preencha com
# seus valores reais. O arquivo ".env" NUNCA deve ser compartilhado nem
# enviado pro GitHub — ele é lido automaticamente pelo bot (via dotenv).

# Senha mestra usada nos comandos administrativos por WhatsApp
# (/criarusuario, /listarusuarios, /removerusuario). Escolha algo difícil.
SENHA_MESTRA_ADMIN= ESCOLHA UMA SENHA MESTRA

# Opcional: protege o painel web com uma senha extra (além do login de
# atendente). Veja o LEIA-ME-PAINEL.md pra mais detalhes.
# PAINEL_TOKEN=SENHA EXTRA 

# ==== Instagram Direct (opcional) ====
# Sem essas 2 primeiras preenchidas, a integração com Instagram fica
# desativada e o bot continua funcionando normalmente só no WhatsApp.
# Veja o passo a passo completo (criar App na Meta, gerar token, configurar
# webhook) no LEIA-ME-PAINEL.md, seção "Instagram Direct".

# Token de acesso de longa duração da conta/página do Instagram, gerado no
# painel de desenvolvedor da Meta (developers.facebook.com).
# INSTAGRAM_ACCESS_TOKEN=65c8775df97b12fa221adf781c70e8c4

# Palavra-chave escolhida por você mesmo, usada só na hora de validar o
# webhook lá no painel da Meta (precisa ser a MESMA nos dois lugares).
# INSTAGRAM_VERIFY_TOKEN=65c8775df97b12fa221adf781c70e8c4

# Opcional, mas recomendado: usado pra validar a assinatura das
# requisições do webhook, garantindo que vieram mesmo da Meta.
# INSTAGRAM_APP_SECRET=
# Opcional: ID numérico da conta do Instagram, usado só em logs/diagnóstico.
# INSTAGRAM_ACCOUNT_ID=